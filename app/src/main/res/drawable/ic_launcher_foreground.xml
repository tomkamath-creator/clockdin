<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Ambient Outer Cosmic Glow -->
    <path
        android:pathData="M54,54m-38,0a38,38 0,1,1 76,0a38,38 0,1,1 -76,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="38"
                android:type="radial">
                <item android:offset="0.0" android:color="#4D9C27B0" />
                <item android:offset="0.55" android:color="#243F51B5" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Fine Space Dust (scattered cosmic particles) -->
    <path android:fillColor="#FFFFFFAA" android:pathData="M32,28m-1,0a1,1 0,1,1 2,0a1,1 0,1,1 -2,0" />
    <path android:fillColor="#FF80DEEA" android:pathData="M76,32m-1.2,0a1.2,1.2 0,1,1 2.4,0a1.2,1.2 0,1,1 -2.4,0" />
    <path android:fillColor="#FFFFD54F" android:pathData="M26,68m-1,0a1,1 0,1,1 2,0a1,1 0,1,1 -2,0" />
    <path android:fillColor="#FFE1BEE7" android:pathData="M80,66m-1.1,0a1.1,1.1 0,1,1 2.2,0a1.1,1.1 0,1,1 -2.2,0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M38,78m-0.8,0a0.8,0.8 0,1,1 1.6,0a0.8,0.8 0,1,1 -1.6,0" />
    <path android:fillColor="#FF4DD0E1" android:pathData="M68,80m-0.9,0a0.9,0.9 0,1,1 1.8,0a0.9,0.9 0,1,1 -1.8,0" />
    <path android:fillColor="#FFFFE082" android:pathData="M52,20m-0.9,0a0.9,0.9 0,1,1 1.8,0a0.9,0.9 0,1,1 -1.8,0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M23,46m-0.7,0a0.7,0.7 0,1,1 1.4,0a0.7,0.7 0,1,1 -1.4,0" />
    <path android:fillColor="#FFB388FF" android:pathData="M85,50m-0.8,0a0.8,0.8 0,1,1 1.6,0a0.8,0.8 0,1,1 -1.6,0" />

    <!-- 3. Orbital Ring (Rear Segment passing behind sphere) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-26">
        <path
            android:pathData="M18,54 A36,11 0 0,1 90,54"
            android:strokeWidth="1.8"
            android:strokeColor="#6600E5FF"
            android:strokeLineCap="round" />
    </group>

    <!-- 4. Glowing Cosmic Sphere -->
    <path
        android:pathData="M54,54m-20,0a20,20 0,1,1 40,0a20,20 0,1,1 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="47"
                android:centerY="46"
                android:gradientRadius="26"
                android:type="radial">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.22" android:color="#FFFFD54F" />
                <item android:offset="0.52" android:color="#FFFF4081" />
                <item android:offset="0.82" android:color="#FF7C4DFF" />
                <item android:offset="1.0" android:color="#FF0D1B2A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 5. Inner Core Specular Atmosphere -->
    <path
        android:pathData="M54,54m-19,0a19,19 0,1,1 38,0a19,19 0,1,1 -38,0"
        android:strokeWidth="1.2"
        android:strokeColor="#50FFFFFF" />

    <!-- 6. Orbital Ring (Front Segment circling in front of sphere) -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-26">
        <!-- Glowing outer aura of front ring -->
        <path
            android:pathData="M90,54 A36,11 0 0,1 18,54"
            android:strokeWidth="3.6"
            android:strokeColor="#4000E5FF"
            android:strokeLineCap="round" />
        <!-- Sharp luminous front ring core -->
        <path
            android:pathData="M90,54 A36,11 0 0,1 18,54"
            android:strokeWidth="1.8"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:startX="18"
                    android:startY="54"
                    android:endX="90"
                    android:endY="54"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#80FF80AB" />
                    <item android:offset="0.3" android:color="#FFFFFFFF" />
                    <item android:offset="0.7" android:color="#FF00E5FF" />
                    <item android:offset="1.0" android:color="#80B388FF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Fine glittering particle on the orbital ring -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M34,62.8m-1.2,0a1.2,1.2 0,1,1 2.4,0a1.2,1.2 0,1,1 -2.4,0" />
    </group>

</vector>
